# Proveedor LLM (requerido si no inyectás un generator personalizado)
# MonoRAG usa el cliente OpenAI-compatible incluido; por eso puede hablar con
# OpenAI, Groq, Google AI Studio, Ollama, LM Studio u otro endpoint compatible.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=your_api_key_here

# Alias conocidos:
# openai, groq, google-ai-studio, ollama, lm-studio, openai-compatible

# URL base del proveedor LLM
# - Opcional para alias conocidos.
# - Requerida para endpoints OpenAI-compatible custom.
# OpenAI:           https://api.openai.com/v1
# Groq:             https://api.groq.com/openai/v1
# Ollama:           http://localhost:11434/v1
# LM Studio:        http://localhost:1234/v1
# Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai/
# Custom:           https://llm.example.com/v1
# LLM_BASE_URL=https://api.openai.com/v1

# Modelo a usar (opcional; usa un default práctico por alias si se omite)
# OpenAI: gpt-4o
# Groq: llama-3.3-70b-versatile
# Ollama: llama3.2
# Google AI Studio: gemini-2.0-flash
# LLM_MODEL=gpt-4o

# Storage/vector DB
# Local por defecto:
# - Windows: %LOCALAPPDATA%/monorag/chroma_db
# - Linux:   $XDG_DATA_HOME/monorag/chroma_db o ~/.local/share/monorag/chroma_db
# - macOS:   ~/Library/Application Support/monorag/chroma_db
# MonoRAG crea la carpeta automáticamente. Si querés, podés usar cualquier carpeta:
# MONORAG_DB_PATH=C:/ruta/a/mi/chroma_db

# Chroma remoto/local por servidor HTTP(S):
# MONORAG_CHROMA_URL=http://localhost:8000
# MONORAG_CHROMA_API_KEY=optional-token
# MONORAG_CHROMA_TENANT=optional-tenant
# MONORAG_CHROMA_DATABASE=optional-database

# Compatibilidad con versiones anteriores (deprecated, preferí LLM_API_KEY)
# GROQ_API_KEY=your_api_key_here
