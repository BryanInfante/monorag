# Inspector END — Environment Configuration
#
# Copy this file to .env and fill in the values.
# The only required value is LLM_API_KEY.

# LLM Provider (default: groq)
LLM_PROVIDER=groq

# LLM API Key (required)
LLM_API_KEY=gsk_your_groq_api_key_here

# LLM Model (default: llama-3.3-70b-versatile)
LLM_MODEL=llama-3.3-70b-versatile

# Custom base URL (optional, only for non-standard endpoints)
# LLM_BASE_URL=

# MonoRAG collection name (default: inspector-end)
MONORAG_COLLECTION=inspector-end

# ChromaDB persistence path (optional, defaults to OS user data dir)
# MONORAG_DB_PATH=/app/data/chroma_db
